{
  "$comment": "Single source of truth for Syncit design tokens. Edit this file, then run `npm run tokens:build` to regenerate tailwind.tokens.mjs and mobile/src/theme.ts. Do not hand-edit the outputs.",
  "colors": {
    "bond":   { "hex": "#093D30", "use": "Primary, headers, app bar" },
    "kiln":   { "hex": "#12876C", "use": "Interactive, focus rings, links" },
    "set":    { "hex": "#3DDC97", "use": "Accent, success, the sync mark" },
    "cure":   { "hex": "#B96A00", "use": "Awaiting approval, on hold" },
    "fault":  { "hex": "#B42318", "use": "Rejected, errors, credit block" },
    "bench":  { "hex": "#F5F7F6", "use": "Surfaces, cards" },
    "ink":    { "hex": "#0B1D18", "use": "Text" },
    "inkMuted": { "hex": "#5A6B65", "use": "Secondary text" },
    "line":   { "hex": "#D8DEDC", "use": "Borders, dividers" },
    "curBg":  { "hex": "#FEF3C7", "use": "Warning surface (cure light)" },
    "faultBg":{ "hex": "#FEE4E2", "use": "Error surface (fault light)" },
    "white":  { "hex": "#FFFFFF" }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32
  },
  "radius": {
    "sm": 6,
    "md": 12,
    "lg": 20,
    "pill": 999
  },
  "type": {
    "$comment": "16 body minimum per brief; larger scale for titles because these users often hold the phone at arm's length in variable light.",
    "bodySmall": 16,
    "body": 18,
    "button": 18,
    "heading": 22,
    "title": 28
  },
  "tap": {
    "$comment": "56px matches Material 'large' button spec and is comfortable for users wearing gloves. Brief requires 56px minimum.",
    "min": 56
  },
  "fonts": {
    "body": "Inter",
    "display": "Inter Tight"
  }
}
