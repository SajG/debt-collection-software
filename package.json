{
  "name": "syncit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "test": "vitest run",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:studio": "prisma studio",
    "verify:team": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/verify-team.ts",
    "rotate:compromised": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/rotate-compromised-passwords.ts",
    "backfill:team-emails": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/backfill-team-emails.ts",
    "verify:emails": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/verify-emails.ts",
    "dev:otp": "node --env-file=.env scripts/dev-get-otp.mjs",
    "brand:build": "node syncit-brand/build-assets.mjs",
    "tokens:build": "node packages/tokens/generate.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "billing:create-plans": "node --env-file=.env ./node_modules/.bin/ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/billing-create-plans.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.64.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.13.3",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
