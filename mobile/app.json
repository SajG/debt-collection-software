{
  "expo": {
    "name": "Syncit",
    "slug": "syncit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "syncit",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/PLACEHOLDER_EAS_PROJECT_ID",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#093D30"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.getsyncit"
    },
    "android": {
      "package": "app.getsyncit",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#093D30"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#093D30",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Syncit needs camera/photo access so you can attach payment proof (bank screenshot, cheque photo) after recording a payment.",
          "cameraPermission": "Syncit uses the camera to capture payment proofs and order proofs while you're at the customer site."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Syncit uses Face ID to unlock the app so your company's order and customer data stays private if the phone is lost."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#093D30",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-localization",
      "@sentry/react-native"
    ],
    "notification": {
      "iosDisplayInForeground": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
