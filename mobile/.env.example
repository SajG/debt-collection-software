# Copy to .env and fill in.
# EXPO_PUBLIC_ prefix inlines the value at build time — safe for the anon
# key + URL, which are already exposed to the client anyway.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# Base URL of the Next.js web deployment. Used by the mobile app to
# hit POST /api/auth/request-code so the same per-email rate limit
# applies to mobile as to web (SY15.7 + audit item 9).
EXPO_PUBLIC_APP_URL=https://getsyncit.app

# Used by `npm run types:generate` (Supabase CLI). Not shipped to the client.
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Optional __DEV__-only login. Never set these in EAS production env.
# EXPO_PUBLIC_DEV_TEST_EMAIL=mobile-dev@example.com
# EXPO_PUBLIC_DEV_TEST_OTP=123456
