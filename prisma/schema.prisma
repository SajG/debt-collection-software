generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
}

enum AccountingTool {
  TALLY
  ZOHO
  SAP
  EXCEL
  OTHER
}

enum PartyPriority {
  HIGH
  MEDIUM
  LOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceSource {
  TALLY
  MANUAL
}

enum PaymentMethod {
  CASH
  CHEQUE
  NEFT
  RTGS
  UPI
  OTHER
}

enum PaymentSource {
  TALLY
  MANUAL
}

enum ActionType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  NOTE
  OTHER
}

enum ActionOutcome {
  PROMISE_TO_PAY
  NOT_REACHABLE
  CALL_BACK_LATER
  DISPUTED
  PAYMENT_RECEIVED
  NO_ANSWER
  WRONG_NUMBER
  OTHER
}

enum ProformaStatus {
  DRAFT
  SENT
  CONFIRMED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum SyncType {
  IMPORT_PARTIES
  IMPORT_INVOICES
  IMPORT_PAYMENTS
  FULL_IMPORT
  EXPORT_PAYMENTS
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  BLOCKED // stopped by the sending gate; never left the system
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED // inbound
}

// ─────────────────────────────────────────────────────────────────
// PROFILE  (auth identity lives in Supabase auth.users)
// ─────────────────────────────────────────────────────────────────

model Profile {
  id           String   @id @db.Uuid   // mirrors auth.users.id
  businessName String
  ownerName    String
  phone        String?
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businessSettings BusinessSettings?

  assignedParties  Party[]           @relation("PartyAssignee")
  recordedPayments Payment[]         @relation("PaymentRecorder")
  performedActions Action[]          @relation("ActionPerformer")
  createdProformas ProformaInvoice[] @relation("ProformaCreator")
  triggeredSyncs   SyncLog[]         @relation("SyncTrigger")
  sentMessages     Message[]         @relation("MessageSender")
}

// ─────────────────────────────────────────────────────────────────
// BUSINESS SETTINGS  (single row per deployment)
// ─────────────────────────────────────────────────────────────────

model BusinessSettings {
  id        String @id @default(cuid())
  profileId String @unique @db.Uuid

  // Onboarding
  accountingTool AccountingTool @default(EXCEL)
  onboardingDone Boolean        @default(false)

  // Company details
  companyGstNumber String?
  companyAddress   String?
  companyState     String?
  companyCityPin   String?

  // AR defaults
  defaultCreditDays Int?

  // Outreach guardrails (enforced by the deterministic sending gate)
  timezone             String  @default("Asia/Kolkata") // IANA tz for quiet hours
  quietHoursStart      Int     @default(8) // local hour — no sends before this
  quietHoursEnd        Int     @default(19) // local hour — no sends at/after this
  maxMessagesPerDay    Int     @default(1) // per party, per calendar day
  maxMessagesPerWeek   Int     @default(3) // per party, rolling 7 days
  autoRemindersEnabled Boolean @default(false) // cron-driven reminder pass

  // Proforma number sequence
  // Incremented atomically on each proforma creation.
  // Format generated in app: PF-{YYYY}-{proformaSeq zero-padded to 4 digits}
  // Reset to 0 each calendar year (tracked via proformaSeqYear).
  proformaSeq     Int @default(0)
  proformaSeqYear Int @default(0) // set to current year on first use

  // Tally sync config
  tallyHost        String?
  tallyPort        Int?     // default 9000
  tallyCompanyName String?

  // WhatsApp Business API config
  // whatsappApiToken is AES-256-GCM encrypted at rest (lib/crypto.ts).
  // Decrypt server-side only; never select it into a client payload.
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?
  whatsappApiToken          String?
  // Pre-approved UTILITY-category template used for reminders.
  // Marketing-category templates must never be used for payment follow-ups.
  whatsappTemplateName      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────
// PARTY  (customer / buyer)
// ─────────────────────────────────────────────────────────────────

model Party {
  id            String  @id @default(cuid())
  name          String
  code          String? // internal code / Tally alias
  gstNumber     String?
  phone         String?
  email         String?
  contactPerson String? // primary contact for payment follow-up
  address       String?
  city          String?
  state         String?

  creditLimit Decimal? @db.Decimal(12, 2)
  creditDays  Int?     // agreed payment terms in days

  // Cached AR balance — update via app whenever invoices or payments change
  totalOutstanding Decimal @default(0) @db.Decimal(12, 2)

  priority  PartyPriority @default(MEDIUM)
  riskLevel RiskLevel     @default(LOW)
  isActive  Boolean       @default(true)

  assignedToId String?  @db.Uuid
  assignedTo   Profile? @relation("PartyAssignee", fields: [assignedToId], references: [id])

  // Deduplication key for Tally sync; null for manually-added parties
  tallyRef String? @unique

  // ── Outreach compliance ────────────────────────────────────────
  // No automated message may be sent unless consentStatus is OPTED_IN.
  consentStatus    ConsentStatus @default(UNKNOWN)
  consentUpdatedAt DateTime?

  // Set when a DISPUTED outcome is recorded (or manually). Blocks ALL
  // outbound messages until a human clears it.
  outreachPaused       Boolean   @default(false)
  outreachPausedReason String?
  outreachPausedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  payments     Payment[]
  actions      Action[]
  proformas    ProformaInvoice[]
  messages     Message[]
  paymentLinks PaymentLink[]

  @@index([assignedToId])
  @@index([isActive, priority])
  @@index([totalOutstanding])
  @@index([riskLevel])
}

// ─────────────────────────────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  partyId       String
  invoiceDate   DateTime
  dueDate       DateTime
  totalAmount   Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  // pendingAmount = totalAmount - paidAmount → computed in app
  status        InvoiceStatus @default(UNPAID)
  source        InvoiceSource @default(MANUAL)
  tallyRef      String?       // Tally voucher ref for sync dedup
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party        Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  payments     Payment[]
  messages     Message[]
  paymentLinks PaymentLink[]

  // Invoice numbers are unique per party, not globally
  // (mirrors Tally's behaviour across companies)
  @@unique([partyId, invoiceNumber])
  @@index([partyId])
  @@index([dueDate])
  @@index([status])
  @@index([partyId, status])
}

// ─────────────────────────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  partyId     String
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime
  method      PaymentMethod @default(NEFT)
  reference   String?       // cheque number, UTR, UPI transaction ID
  notes       String?

  // Optional single-invoice link for v1.
  // Upgrade path: add a PaymentAllocation join table for split payments.
  invoiceId String?

  recordedById String        @db.Uuid
  source       PaymentSource @default(MANUAL)
  tallyRef     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party      Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  recordedBy Profile  @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([partyId])
  @@index([paymentDate])
  @@index([partyId, paymentDate])
}

// ─────────────────────────────────────────────────────────────────
// ACTION / FOLLOW-UP LOG
// ─────────────────────────────────────────────────────────────────

model Action {
  id              String         @id @default(cuid())
  partyId         String
  performedById   String         @db.Uuid
  type            ActionType
  outcome         ActionOutcome?
  notes           String?
  contactedPerson String?        // who was spoken to at the party side

  // Promise-to-pay tracking
  promiseDate   DateTime?
  promiseAmount Decimal?  @db.Decimal(12, 2)

  // Next follow-up scheduling
  nextFollowUpDate DateTime?

  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  party       Party   @relation(fields: [partyId], references: [id], onDelete: Restrict)
  performedBy Profile @relation("ActionPerformer", fields: [performedById], references: [id])

  @@index([partyId])
  @@index([performedById])
  @@index([nextFollowUpDate])
  @@index([partyId, performedAt])
}

// ─────────────────────────────────────────────────────────────────
// PROFORMA INVOICE
// ─────────────────────────────────────────────────────────────────

model ProformaInvoice {
  id             String         @id @default(cuid())
  proformaNumber String         @unique // format: PF-{YYYY}-{NNNN}, generated by app
  partyId        String
  createdById    String         @db.Uuid
  issueDate      DateTime       @default(now())
  validUntil     DateTime?
  status         ProformaStatus @default(DRAFT)

  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  notes           String?
  termsConditions String?

  // Populated when status transitions to CONVERTED
  convertedToInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party     Party              @relation(fields: [partyId], references: [id], onDelete: Restrict)
  createdBy Profile            @relation("ProformaCreator", fields: [createdById], references: [id])
  lineItems ProformaLineItem[]

  @@index([partyId])
  @@index([status])
}

model ProformaLineItem {
  id          String  @id @default(cuid())
  proformaId  String
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unit        String? // "kg", "box", "pcs", "mtr", etc.
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2) // 18.00 = 18% GST
  taxAmount   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)            // (qty × unitPrice) + taxAmount
  sortOrder   Int     @default(0)

  proforma ProformaInvoice @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
}

// ─────────────────────────────────────────────────────────────────
// SYNC LOG  (Tally integration history)
// ─────────────────────────────────────────────────────────────────

model SyncLog {
  id               String     @id @default(cuid())
  syncType         SyncType
  status           SyncStatus @default(PENDING)
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  recordsTotal     Int?
  recordsProcessed Int?
  recordsFailed    Int?
  errorMessage     String?
  details          Json?      // per-record errors / warnings

  triggeredById String?  @db.Uuid
  triggeredBy   Profile? @relation("SyncTrigger", fields: [triggeredById], references: [id])

  createdAt DateTime @default(now())

  @@index([syncType, startedAt])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────
// MESSAGE  (exportable audit trail of every outreach attempt,
// including gate-blocked attempts and inbound replies)
// ─────────────────────────────────────────────────────────────────

model Message {
  id        String           @id @default(cuid())
  partyId   String
  invoiceId String?
  channel   MessageChannel
  direction MessageDirection
  status    MessageStatus

  templateName String? // WhatsApp utility template used, if any
  body         String // exact content sent or received
  gateResult   String? // why the gate blocked this attempt (status BLOCKED)

  providerMessageId String? // BSP/provider id for delivery-status webhooks
  error             String? // provider error for status FAILED
  paymentLinkUrl    String?

  sentById String? @db.Uuid // null for automated (cron) or inbound messages

  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  sentBy  Profile? @relation("MessageSender", fields: [sentById], references: [id])

  @@index([partyId, createdAt])
  @@index([status])
  @@index([providerMessageId])
  @@index([channel, direction, createdAt])
}

// ─────────────────────────────────────────────────────────────────
// PAYMENT LINK  (Razorpay payment links embedded in reminders)
// ─────────────────────────────────────────────────────────────────

model PaymentLink {
  id             String  @id @default(cuid())
  partyId        String
  invoiceId      String?
  provider       String  @default("RAZORPAY")
  providerLinkId String  @unique
  shortUrl       String
  amount         Decimal @db.Decimal(12, 2)
  status         String  @default("created") // Razorpay: created/partially_paid/paid/cancelled/expired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([partyId])
}

// ─────────────────────────────────────────────────────────────────
// AUTH SECURITY  (defense-in-depth on top of Supabase rate-limiting)
// ─────────────────────────────────────────────────────────────────

model LoginAttempt {
  id         String   @id @default(cuid())
  email      String
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
}
