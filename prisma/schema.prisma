generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  FACTORY
}

enum AccountingTool {
  TALLY
  ZOHO
  SAP
  EXCEL
  OTHER
}

enum PartyPriority {
  HIGH
  MEDIUM
  LOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceSource {
  TALLY
  MANUAL
}

enum PaymentMethod {
  CASH
  CHEQUE
  NEFT
  RTGS
  UPI
  OTHER
}

enum PaymentSource {
  TALLY
  MANUAL
}

enum ActionType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  NOTE
  OTHER
}

enum ActionOutcome {
  PROMISE_TO_PAY
  NOT_REACHABLE
  CALL_BACK_LATER
  DISPUTED
  PAYMENT_RECEIVED
  NO_ANSWER
  WRONG_NUMBER
  OTHER
}

enum ProformaStatus {
  DRAFT
  SENT
  CONFIRMED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum CreditNoteStatus {
  ISSUED
  CANCELLED
}

enum SyncType {
  IMPORT_PARTIES
  IMPORT_INVOICES
  IMPORT_PAYMENTS
  IMPORT_RECEIPTS
  IMPORT_STOCK_ITEMS
  FULL_IMPORT
  EXPORT_PAYMENTS
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
}

enum AccountingProvider {
  ZOHO_BOOKS
  QUICKBOOKS
  XERO
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  BLOCKED // stopped by the sending gate; never left the system
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED // inbound
}

enum OrderStatus {
  ORDER_PLACED
  IN_PRODUCTION
  ON_HOLD
  READY_TO_DISPATCH
  LR_GENERATED
  PARTIALLY_DISPATCHED
  DISPATCHED
  CANCELLED
}

enum HoldReasonCategory {
  RAW_MATERIAL_SHORTAGE
  AWAITING_CUSTOMER_CONFIRMATION
  PAYMENT_HOLD
  OTHER
}

enum DocumentType {
  INVOICE
  LORRY_RECEIPT
  ORDER_PROOF
  OTHER
}

enum PaymentDocumentType {
  BANK_SCREENSHOT
  CHEQUE_PHOTO
  UPI_SCREENSHOT
  RECEIPT
  OTHER
}

// ─────────────────────────────────────────────────────────────────
// PROFILE  (auth identity lives in Supabase auth.users)
// ─────────────────────────────────────────────────────────────────

model Profile {
  id             String   @id @db.Uuid // mirrors auth.users.id
  businessName   String
  ownerName      String
  phone          String?
  role           Role     @default(STAFF)
  // Maps this salesperson to their Tally Cost Centre / Sales Executive name
  costCentreName String?
  // Notification prefs — default all ON; toggled from mobile settings.
  notifyStatusChanges Boolean @default(true)
  notifyDocuments     Boolean @default(true)
  notifyStaleOrders   Boolean @default(true)
  notifyCreditIssues  Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessSettings BusinessSettings?
  pushTokens       PushToken[]

  assignedParties      Party[]            @relation("PartyAssignee")
  recordedPayments     Payment[]          @relation("PaymentRecorder")
  performedActions     Action[]           @relation("ActionPerformer")
  createdProformas     ProformaInvoice[]  @relation("ProformaCreator")
  triggeredSyncs       SyncLog[]          @relation("SyncTrigger")
  sentMessages         Message[]          @relation("MessageSender")
  issuedCreditNotes    CreditNote[]       @relation("CreditNoteIssuer")
  cancelledCreditNotes CreditNote[]       @relation("CreditNoteCanceller")
  salesOrders          SalesOrder[]       @relation("OrderSalesperson")
  orderStatusEvents    OrderStatusEvent[] @relation("OrderStatusUpdater")
  orderDocuments       OrderDocument[]    @relation("DocumentUploader")
  paymentDocuments     PaymentDocument[]  @relation("PaymentDocumentUploader")
  createdDispatchLots  DispatchLot[]      @relation("DispatchLotCreator")
}

// ─────────────────────────────────────────────────────────────────
// BUSINESS SETTINGS  (single row per deployment)
// ─────────────────────────────────────────────────────────────────

model BusinessSettings {
  id        String @id @default(cuid())
  profileId String @unique @db.Uuid

  // Onboarding
  accountingTool AccountingTool @default(EXCEL)
  onboardingDone Boolean        @default(false)

  // Company details
  companyGstNumber String?
  companyAddress   String?
  companyState     String?
  companyCityPin   String?

  // AR defaults
  defaultCreditDays Int?

  // Outreach guardrails (enforced by the deterministic sending gate)
  timezone             String  @default("Asia/Kolkata") // IANA tz for quiet hours
  quietHoursStart      Int     @default(8) // local hour — no sends before this
  quietHoursEnd        Int     @default(19) // local hour — no sends at/after this
  maxMessagesPerDay    Int     @default(1) // per party, per calendar day
  maxMessagesPerWeek   Int     @default(3) // per party, rolling 7 days
  autoRemindersEnabled Boolean @default(false) // cron-driven reminder pass

  // Proforma number sequence
  // Incremented atomically on each proforma creation.
  // Format generated in app: PF-{YYYY}-{proformaSeq zero-padded to 4 digits}
  // Reset to 0 each calendar year (tracked via proformaSeqYear).
  proformaSeq     Int @default(0)
  proformaSeqYear Int @default(0) // set to current year on first use

  // Credit note number sequence — same per-year pattern as proformas.
  // Format generated in app: CN-{YYYY}-{creditNoteSeq zero-padded to 4 digits}
  creditNoteSeq     Int @default(0)
  creditNoteSeqYear Int @default(0)

  // Company branding & bank details (rendered on proforma/invoice PDFs)
  // companyLogoPath is an object path in the private Supabase Storage
  // bucket (lib/storage.ts) — read via short-lived signed URLs only.
  // bankAccountNumber is AES-256-GCM encrypted at rest (lib/crypto.ts);
  // decrypt server-side only, never select into a client payload.
  companyLogoPath         String?
  bankAccountName         String?
  bankAccountNumber       String?
  bankIfscCode            String?
  bankName                String?
  bankBranch              String?
  invoicePrefix           String? // e.g. "INV" — used when converting proformas
  authorizedSignatoryName String?

  // Tally sync config
  tallyHost        String?
  tallyPort        Int? // default 9000
  tallyCompanyName String?

  // WhatsApp Business API config
  // whatsappApiToken is AES-256-GCM encrypted at rest (lib/crypto.ts).
  // Decrypt server-side only; never select it into a client payload.
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?
  whatsappApiToken          String?
  // Pre-approved UTILITY-category template used for reminders.
  // Marketing-category templates must never be used for payment follow-ups.
  whatsappTemplateName      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────
// PARTY  (customer / buyer)
// ─────────────────────────────────────────────────────────────────

model Party {
  id            String  @id @default(cuid())
  name          String
  code          String? // internal code / Tally alias
  gstNumber     String?
  phone         String?
  email         String?
  contactPerson String? // primary contact for payment follow-up
  address       String?
  city          String?
  state         String?

  creditLimit Decimal? @db.Decimal(12, 2)
  creditDays  Int? // agreed payment terms in days

  // Cached AR balance — update via app whenever invoices or payments change
  totalOutstanding Decimal @default(0) @db.Decimal(12, 2)
  // Snapshot from the last Tally ledger sync — the reconciliation
  // report compares this against totalOutstanding to catch sync bugs.
  tallyOutstanding Decimal? @db.Decimal(14, 2)
  tallyBalanceAsOf DateTime? @db.Timestamptz

  // Tally Cost Centre / Sales Executive name — used for auto-assignment
  // to the Profile whose costCentreName matches this value
  costCentre String?

  priority  PartyPriority @default(MEDIUM)
  riskLevel RiskLevel     @default(LOW)
  isActive  Boolean       @default(true)

  assignedToId String?  @db.Uuid
  assignedTo   Profile? @relation("PartyAssignee", fields: [assignedToId], references: [id])

  // Deduplication key for Tally sync; null for manually-added parties
  tallyRef String? @unique

  // ── Outreach compliance ────────────────────────────────────────
  // No automated message may be sent unless consentStatus is OPTED_IN.
  consentStatus    ConsentStatus @default(UNKNOWN)
  consentUpdatedAt DateTime?

  // Set when a DISPUTED outcome is recorded (or manually). Blocks ALL
  // outbound messages until a human clears it.
  outreachPaused       Boolean   @default(false)
  outreachPausedReason String?
  outreachPausedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  payments     Payment[]
  actions      Action[]
  proformas    ProformaInvoice[]
  messages     Message[]
  paymentLinks PaymentLink[]
  creditNotes  CreditNote[]
  salesOrders  SalesOrder[]

  @@index([assignedToId])
  @@index([isActive, priority])
  @@index([totalOutstanding])
  @@index([riskLevel])
}

// ─────────────────────────────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  partyId        String
  invoiceDate    DateTime
  dueDate        DateTime
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  // Cached Σ(amount) over non-cancelled credit notes on this invoice.
  // Maintained inside the credit-note issue/cancel transactions.
  creditedAmount Decimal       @default(0) @db.Decimal(12, 2)
  // pendingAmount = totalAmount - paidAmount - creditedAmount → computed in app
  status         InvoiceStatus @default(UNPAID)
  source         InvoiceSource @default(MANUAL)
  tallyRef       String? // Tally voucher ref for sync dedup
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party        Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  payments     Payment[]
  messages     Message[]
  paymentLinks PaymentLink[]
  creditNotes  CreditNote[]

  // Invoice numbers are unique per party, not globally
  // (mirrors Tally's behaviour across companies)
  @@unique([partyId, invoiceNumber])
  @@index([partyId])
  @@index([dueDate])
  @@index([status])
  @@index([partyId, status])
}

// ─────────────────────────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  partyId     String
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime
  method      PaymentMethod @default(NEFT)
  reference   String? // cheque number, UTR, UPI transaction ID
  notes       String?

  // Optional single-invoice link for v1.
  // Upgrade path: add a PaymentAllocation join table for split payments.
  invoiceId String?

  recordedById String        @db.Uuid
  source       PaymentSource @default(MANUAL)
  // Format: 'receipt:<voucher-guid>:<invoice-number>' for allocated rows,
  // 'receipt:<voucher-guid>:onaccount' for the residual. Partial-unique
  // in the DB so re-runs of the Tally sync upsert instead of duplicating.
  tallyRef     String?       @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party      Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  recordedBy Profile  @relation("PaymentRecorder", fields: [recordedById], references: [id])
  documents  PaymentDocument[]

  @@index([partyId])
  @@index([paymentDate])
  @@index([partyId, paymentDate])
}

// ─────────────────────────────────────────────────────────────────
// PAYMENT DOCUMENT (bank screenshot, cheque photo, UPI screenshot,
// signed receipt — anything a salesperson / accountant photographs
// alongside a payment for later bank reconciliation)
// ─────────────────────────────────────────────────────────────────

model PaymentDocument {
  id           String              @id @default(cuid())
  paymentId    String
  type         PaymentDocumentType
  storagePath  String // Supabase Storage object path, private bucket
  fileName     String? // original client filename for display
  uploadedById String              @db.Uuid
  notes        String?
  createdAt    DateTime            @default(now())

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedBy Profile @relation("PaymentDocumentUploader", fields: [uploadedById], references: [id])

  @@index([paymentId])
}

// ─────────────────────────────────────────────────────────────────
// ACTION / FOLLOW-UP LOG
// ─────────────────────────────────────────────────────────────────

model Action {
  id              String         @id @default(cuid())
  partyId         String
  performedById   String         @db.Uuid
  type            ActionType
  outcome         ActionOutcome?
  notes           String?
  contactedPerson String? // who was spoken to at the party side

  // Promise-to-pay tracking
  promiseDate   DateTime?
  promiseAmount Decimal?  @db.Decimal(12, 2)

  // Next follow-up scheduling
  nextFollowUpDate DateTime?

  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  party       Party   @relation(fields: [partyId], references: [id], onDelete: Restrict)
  performedBy Profile @relation("ActionPerformer", fields: [performedById], references: [id])

  @@index([partyId])
  @@index([performedById])
  @@index([nextFollowUpDate])
  @@index([partyId, performedAt])
}

// ─────────────────────────────────────────────────────────────────
// PROFORMA INVOICE
// ─────────────────────────────────────────────────────────────────

model ProformaInvoice {
  id             String         @id @default(cuid())
  proformaNumber String         @unique // format: PF-{YYYY}-{NNNN}, generated by app
  partyId        String
  createdById    String         @db.Uuid
  issueDate      DateTime       @default(now())
  validUntil     DateTime?
  status         ProformaStatus @default(DRAFT)

  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  notes           String?
  termsConditions String?

  // Populated when status transitions to CONVERTED
  convertedToInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party     Party              @relation(fields: [partyId], references: [id], onDelete: Restrict)
  createdBy Profile            @relation("ProformaCreator", fields: [createdById], references: [id])
  lineItems ProformaLineItem[]

  @@index([partyId])
  @@index([status])
}

model ProformaLineItem {
  id          String  @id @default(cuid())
  proformaId  String
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unit        String? // "kg", "box", "pcs", "mtr", etc.
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2) // 18.00 = 18% GST
  taxAmount   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2) // (qty × unitPrice) + taxAmount
  sortOrder   Int     @default(0)

  proforma ProformaInvoice @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
}

// ─────────────────────────────────────────────────────────────────
// CREDIT NOTE  (returns / discounts / adjustments against an invoice;
// reduces the invoice's pending balance without touching payment rows)
// ─────────────────────────────────────────────────────────────────

model CreditNote {
  id               String           @id @default(cuid())
  creditNoteNumber String           @unique // format: CN-{YYYY}-{NNNN}, generated by app
  invoiceId        String
  partyId          String
  amount           Decimal          @db.Decimal(12, 2)
  reason           String
  status           CreditNoteStatus @default(ISSUED)

  issuedById String   @db.Uuid
  issuedAt   DateTime @default(now())

  // Cancellation audit trail (admin-only action)
  cancelledById    String?   @db.Uuid
  cancelledAt      DateTime?
  cancellationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  issuedBy    Profile  @relation("CreditNoteIssuer", fields: [issuedById], references: [id])
  cancelledBy Profile? @relation("CreditNoteCanceller", fields: [cancelledById], references: [id])

  @@index([invoiceId])
  @@index([partyId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────
// SYNC LOG  (Tally integration history)
// ─────────────────────────────────────────────────────────────────

model SyncLog {
  id               String     @id @default(cuid())
  syncType         SyncType
  status           SyncStatus @default(PENDING)
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  recordsTotal     Int?
  recordsProcessed Int?
  recordsFailed    Int?
  errorMessage     String?
  details          Json? // per-record errors / warnings

  triggeredById String?  @db.Uuid
  triggeredBy   Profile? @relation("SyncTrigger", fields: [triggeredById], references: [id])

  createdAt DateTime @default(now())

  @@index([syncType, startedAt])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────
// MESSAGE  (exportable audit trail of every outreach attempt,
// including gate-blocked attempts and inbound replies)
// ─────────────────────────────────────────────────────────────────

model Message {
  id        String           @id @default(cuid())
  partyId   String
  invoiceId String?
  channel   MessageChannel
  direction MessageDirection
  status    MessageStatus

  templateName String? // WhatsApp utility template used, if any
  body         String // exact content sent or received
  gateResult   String? // why the gate blocked this attempt (status BLOCKED)

  providerMessageId String? // BSP/provider id for delivery-status webhooks
  error             String? // provider error for status FAILED
  paymentLinkUrl    String?

  sentById String? @db.Uuid // null for automated (cron) or inbound messages

  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  sentBy  Profile? @relation("MessageSender", fields: [sentById], references: [id])

  @@index([partyId, createdAt])
  @@index([status])
  @@index([providerMessageId])
  @@index([channel, direction, createdAt])
}

// ─────────────────────────────────────────────────────────────────
// PAYMENT LINK  (Razorpay payment links embedded in reminders)
// ─────────────────────────────────────────────────────────────────

model PaymentLink {
  id             String  @id @default(cuid())
  partyId        String
  invoiceId      String?
  provider       String  @default("RAZORPAY")
  providerLinkId String  @unique
  shortUrl       String
  amount         Decimal @db.Decimal(12, 2)
  status         String  @default("created") // Razorpay: created/partially_paid/paid/cancelled/expired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([partyId])
}

// ─────────────────────────────────────────────────────────────────
// ACCOUNTING CONNECTION  (cloud accounting OAuth — Zoho Books,
// QuickBooks, Xero. One connection per provider: single-tenant deploy.)
// ─────────────────────────────────────────────────────────────────

model AccountingConnection {
  id       String             @id @default(cuid())
  provider AccountingProvider @unique

  // OAuth tokens, AES-256-GCM encrypted at rest (lib/crypto.ts).
  // Decrypt server-side only; never select into a client payload.
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?

  // Provider tenant: QuickBooks realmId, Xero tenantId, Zoho organization_id
  externalOrgId String?

  connectedAt DateTime  @default(now())
  lastSyncAt  DateTime?
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// PRODUCT  (factory catalogue — Polygum / Ombond / Omcol / etc.)
// ─────────────────────────────────────────────────────────────────

model Product {
  id        String   @id @default(cuid())
  name      String
  brand     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  salesOrders SalesOrder[]
}

// ─────────────────────────────────────────────────────────────────
// SALES ORDER  (salesperson → factory order pipeline)
// ─────────────────────────────────────────────────────────────────

model SalesOrder {
  id          String @id @default(cuid())
  orderNumber String @unique // format: SB/YY-YY/NNNN, generated same pattern as proformaNumber

  // Exactly one of these two must be set — enforce in application logic, not just here:
  partyId         String? // existing customer, chosen from the salesperson's own ledger dropdown
  newCustomerName String? // free text, only used when the customer isn't in Tally yet

  salespersonId        String      @db.Uuid
  productId            String
  brand                String
  quantity             Decimal     @db.Decimal(10, 3)
  quantityUnit         String // "PCS" | "KG" | "NOS"
  packingType          String?
  sizeKg               String?
  productRate          String // kept as text — rates are written informally
  orderValue           Decimal     @db.Decimal(12, 2) // computed at creation: quantity × rate, best-effort parse
  paymentTerm          String?
  transportType        String?
  expectedDeliveryDate DateTime?
  // Free text — the address the goods should be dispatched to (may differ
  // from the ledger address, e.g. sub-dealer godown).
  dispatchLocation String?
  // "With Synergy Barcode Token" | "With Customer Token" | "Without Token" |
  // "Gift inside" | free text via "Other".
  tokenType String?
  // Filled by factory after order is placed.
  expectedProductionDate DateTime?
  notes                String?
  currentStatus        OrderStatus @default(ORDER_PLACED)
  // Set by putOrderOnHold; releaseOrderHold restores currentStatus to this.
  statusBeforeHold     OrderStatus?
  holdReasonCategory   HoldReasonCategory?
  holdReason           String?
  linkedInvoiceId      String?

  // Credit-limit check outcome at time of placement — kept for audit even if the
  // customer's limit changes later
  creditCheckPassed  Boolean @default(true)
  creditOverrideById String? @db.Uuid // set when a director overrides a blocked order
  creditOverrideNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party        Party?             @relation(fields: [partyId], references: [id])
  salesperson  Profile            @relation("OrderSalesperson", fields: [salespersonId], references: [id])
  product      Product            @relation(fields: [productId], references: [id])
  statusEvents OrderStatusEvent[]
  documents    OrderDocument[]
  dispatchLots DispatchLot[]

  @@index([salespersonId, createdAt])
  @@index([partyId])
  @@index([currentStatus])
  @@index([expectedDeliveryDate])
}

model OrderStatusEvent {
  id           String      @id @default(cuid())
  salesOrderId String
  status       OrderStatus
  notes        String?
  updatedById  String      @db.Uuid
  createdAt    DateTime    @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  updatedBy  Profile    @relation("OrderStatusUpdater", fields: [updatedById], references: [id])

  @@index([salesOrderId, createdAt])
}

model DispatchLot {
  id           String   @id @default(cuid())
  salesOrderId String
  // Same unit as SalesOrder.quantity. Trigger _on_dispatch_lot_change
  // recomputes SalesOrder.currentStatus (PARTIALLY_DISPATCHED /
  // DISPATCHED) based on sum(quantity) vs SalesOrder.quantity.
  quantity     Decimal  @db.Decimal(14, 3)
  lrNumber     String?
  dispatchedAt DateTime @default(now()) @db.Timestamptz
  notes        String?
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  createdBy  Profile    @relation("DispatchLotCreator", fields: [createdById], references: [id])

  @@index([salesOrderId])
}

model OrderDocument {
  id           String       @id @default(cuid())
  salesOrderId String
  type         DocumentType
  storagePath  String // Supabase Storage object path, private bucket
  uploadedById String       @db.Uuid
  createdAt    DateTime     @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  uploadedBy Profile    @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([salesOrderId])
}

// ─────────────────────────────────────────────────────────────────
// STOCK ITEM  (Tally stock snapshot for factory availability)
// ─────────────────────────────────────────────────────────────────

model StockItem {
  id           String    @id @default(cuid())
  name         String    @unique
  category     String?
  unit         String?
  closingQty   Decimal   @db.Decimal(12, 3)
  tallyRef     String?   @unique
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([name])
}

// ─────────────────────────────────────────────────────────────────
// AUTH SECURITY  (defense-in-depth on top of Supabase rate-limiting)
// ─────────────────────────────────────────────────────────────────

model PushToken {
  id         String   @id @default(cuid())
  profileId  String   @db.Uuid
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @db.Timestamptz
  lastSeenAt DateTime @default(now()) @db.Timestamptz

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model NotificationConfig {
  id                 String   @id
  edgeFunctionUrl    String?
  edgeFunctionSecret String?
  staleOrderHours    Int      @default(24)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz
}

model StaleOrderNotice {
  salesOrderId String   @id
  notifiedAt   DateTime @default(now()) @db.Timestamptz
}

model LoginAttempt {
  id         String   @id @default(cuid())
  // Exactly one of email / phone is set. Web login uses email; mobile
  // phone OTP flow uses phone. CHECK constraint in the migration
  // enforces at-least-one at the DB level.
  email      String?
  phone      String?
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([phone, createdAt])
}
