  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  issuedBy    Profile  @relation("CreditNoteIssuer", fields: [issuedById], references: [id])
  cancelledBy Profile? @relation("CreditNoteCanceller", fields: [cancelledById], references: [id])

