generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  FACTORY
}

// SY21 — multi-tenancy. See migration 20260929030000_multi_tenant_orgs
// for the shape and backfill; RLS enforcement is deferred to SY22.

enum OrgPlan {
  TRIAL
  STARTER
  GROWTH
  BUSINESS
}

enum OrgStatus {
  ACTIVE
  PAST_DUE
  LOCKED
}

enum SequenceKind {
  INVOICE
  ORDER
  PROFORMA
  CREDIT_NOTE
}

enum AccountingTool {
  TALLY
  ZOHO
  SAP
  EXCEL
  OTHER
}

enum PartyPriority {
  HIGH
  MEDIUM
  LOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceSource {
  TALLY
  MANUAL
}

enum PaymentMethod {
  CASH
  CHEQUE
  NEFT
  RTGS
  UPI
  OTHER
}

enum PaymentSource {
  TALLY
  MANUAL
}

enum ActionType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  NOTE
  OTHER
}

enum ActionOutcome {
  PROMISE_TO_PAY
  NOT_REACHABLE
  CALL_BACK_LATER
  DISPUTED
  PAYMENT_RECEIVED
  NO_ANSWER
  WRONG_NUMBER
  OTHER
}

enum ProformaStatus {
  DRAFT
  SENT
  CONFIRMED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum CreditNoteStatus {
  ISSUED
  CANCELLED
}

enum SyncType {
  IMPORT_PARTIES
  IMPORT_INVOICES
  IMPORT_PAYMENTS
  IMPORT_RECEIPTS
  IMPORT_STOCK_ITEMS
  FULL_IMPORT
  EXPORT_PAYMENTS
  RECOVERY_CRON
}

enum EscalationStage {
  FLAGGED
  NOTICE
  FINAL_NOTICE
  LEGAL
}

enum EscalationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
}

enum AccountingProvider {
  ZOHO_BOOKS
  QUICKBOOKS
  XERO
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  BLOCKED // stopped by the sending gate; never left the system
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED // inbound
}

enum OrderStatus {
  PENDING_APPROVAL
  ORDER_PLACED
  IN_PRODUCTION
  ON_HOLD
  READY_TO_DISPATCH
  LR_GENERATED
  PARTIALLY_DISPATCHED
  DISPATCHED
  DELIVERED
  REJECTED
  CANCELLED
}

// Per-line production stage on a multi-SKU order. The order's
// SalesOrder.currentStatus is derived (by trigger) as the minimum
// across lines: all READY → READY_TO_DISPATCH, any IN_PRODUCTION →
// IN_PRODUCTION, else stays ORDER_PLACED (or whatever the order is
// in before production starts).
enum LineProductionStatus {
  PENDING
  IN_PRODUCTION
  READY
}

enum OrderApprovalMode {
  NONE
  EXCEPTIONS_ONLY
  ALL
}

enum HoldReasonCategory {
  RAW_MATERIAL_SHORTAGE
  AWAITING_CUSTOMER_CONFIRMATION
  PAYMENT_HOLD
  OTHER
}

enum DocumentType {
  INVOICE
  LORRY_RECEIPT
  ORDER_PROOF
  OTHER
}

enum PaymentDocumentType {
  BANK_SCREENSHOT
  CHEQUE_PHOTO
  UPI_SCREENSHOT
  RECEIPT
  OTHER
}

// ─────────────────────────────────────────────────────────────────
// ORGANIZATION (SY21)
// One row per customer company. Every business table carries
// organizationId; RLS scoping arrives in SY22.
// ─────────────────────────────────────────────────────────────────

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  gstin       String?
  city        String?
  state       String?
  industry    String?
  logoUrl     String?
  plan        OrgPlan   @default(TRIAL)
  trialEndsAt DateTime? @db.Timestamptz
  status      OrgStatus @default(ACTIVE)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  memberships           Membership[]
  parties               Party[]
  invoices              Invoice[]
  payments              Payment[]
  paymentDocuments      PaymentDocument[]
  actions               Action[]
  proformas             ProformaInvoice[]
  proformaLineItems     ProformaLineItem[]
  creditNotes           CreditNote[]
  syncLogs              SyncLog[]
  messages              Message[]
  paymentLinks          PaymentLink[]
  accountingConnections AccountingConnection[]
  products              Product[]
  salesOrders           SalesOrder[]
  salesOrderItems       SalesOrderItem[]
  orderStatusEvents     OrderStatusEvent[]
  dispatchLots          DispatchLot[]
  orderComments         OrderComment[]
  orderDocuments        OrderDocument[]
  stockItems            StockItem[]
  notificationConfigs   NotificationConfig[]
  staleOrderNotices     StaleOrderNotice[]
  escalations           Escalation[]
  escalationEvents      EscalationEvent[]
  recommendations       Recommendation[]
  recoveryTargets       RecoveryTarget[]
  userAuditLogs         UserAuditLog[]
  settings              BusinessSettings?
  numberSequences       OrgNumberSequence[]
  tallyPairingCodes     TallyPairingCode[]
  tallyConnectors       TallyConnector[]

  @@index([status])
}

// One person, N companies. Role + isActive move here from Profile.
// (Profile.role / Profile.isActive stay one release, kept in sync by
// a DB trigger — see migration 20260929030000.)
model Membership {
  id             String   @id @default(cuid())
  organizationId String   @db.Uuid
  profileId      String   @db.Uuid
  role           Role
  isOwner        Boolean  @default(false)
  isActive       Boolean  @default(true)
  invitedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation("MembershipProfile", fields: [profileId], references: [id], onDelete: Cascade)
  invitedBy    Profile?     @relation("MembershipInviter", fields: [invitedById], references: [id])

  @@unique([organizationId, profileId])
  @@index([profileId])
  @@index([organizationId, isActive, role])
}

// Per-organization number sequences. Replaces the global @unique on
// proformaNumber / orderNumber / creditNoteNumber and the
// proformaSeq/creditNoteSeq columns that used to live on
// BusinessSettings. Format is generated in application code from
// (kind, year, seq).
model OrgNumberSequence {
  organizationId String       @db.Uuid
  kind           SequenceKind
  year           Int
  seq            Int          @default(0)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, kind, year])
}

// ─────────────────────────────────────────────────────────────────
// PROFILE  (auth identity lives in Supabase auth.users)
// ─────────────────────────────────────────────────────────────────

model Profile {
  id                  String    @id @db.Uuid // mirrors auth.users.id
  businessName        String
  ownerName           String
  phone               String?
  // Email is the authentication channel (SY-email). Phone remains
  // the identity / display anchor (Tally cost centres, UI). Unique
  // when set; NULL is allowed during backfill. STAFF cannot read
  // colleague emails — see the header of migration
  // 20260828050000_profile_email + the directory-RPC comment.
  email               String?   @unique
  // DEPRECATED (SY21): role and isActive move to Membership so one
  // person can join more than one company. Kept for one release; a
  // DB trigger (sync_profile_from_membership) recomputes both from
  // the caller's highest-privilege active membership. New code should
  // read Membership; do not write to these columns directly.
  role                Role      @default(STAFF)
  isActive            Boolean   @default(true)
  deactivatedAt       DateTime? @db.Timestamptz
  deactivatedById     String?   @db.Uuid
  createdById         String?   @db.Uuid
  // Invite lifecycle. `invitedAt` is set on the first successful
  // inviteUserByEmail; `firstSignInAt` is stamped by AuthContext /
  // the login flow the first time the user actually completes
  // sign-in. Both nullable — legacy users predate the invite path.
  invitedAt           DateTime? @db.Timestamptz
  invitedById         String?   @db.Uuid
  firstSignInAt       DateTime? @db.Timestamptz
  // Maps this salesperson to their Tally Cost Centre / Sales Executive name
  costCentreName      String?
  // Notification prefs — default all ON; toggled from mobile settings.
  notifyStatusChanges Boolean   @default(true)
  notifyDocuments     Boolean   @default(true)
  notifyStaleOrders   Boolean   @default(true)
  notifyCreditIssues  Boolean   @default(true)
  notifyComments      Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // SY21: BusinessSettings moved to 1:1 with Organization. Read
  // settings through Membership → Organization → settings.
  pushTokens       PushToken[]

  assignedParties      Party[]            @relation("PartyAssignee")
  recordedPayments     Payment[]          @relation("PaymentRecorder")
  performedActions     Action[]           @relation("ActionPerformer")
  createdProformas     ProformaInvoice[]  @relation("ProformaCreator")
  triggeredSyncs       SyncLog[]          @relation("SyncTrigger")
  sentMessages         Message[]          @relation("MessageSender")
  issuedCreditNotes    CreditNote[]       @relation("CreditNoteIssuer")
  cancelledCreditNotes CreditNote[]       @relation("CreditNoteCanceller")
  salesOrders          SalesOrder[]       @relation("OrderSalesperson")
  orderStatusEvents    OrderStatusEvent[] @relation("OrderStatusUpdater")
  orderDocuments       OrderDocument[]    @relation("DocumentUploader")
  paymentDocuments     PaymentDocument[]  @relation("PaymentDocumentUploader")
  createdDispatchLots  DispatchLot[]      @relation("DispatchLotCreator")
  orderComments        OrderComment[]     @relation("OrderCommentAuthor")
  approvedOrderItems   SalesOrderItem[]   @relation("SalesOrderItemRateApprover")
  auditLogsAsActor     UserAuditLog[]     @relation("UserAuditActor")
  auditLogsAsTarget    UserAuditLog[]     @relation("UserAuditTarget")
  devices              Device[]           @relation("DeviceOwner")
  revokedDevices       Device[]           @relation("DeviceRevoker")
  recoveryCodes        RecoveryCode[]     @relation("RecoveryCodeOwner")
  recoveryTargets      RecoveryTarget[]   @relation("RecoveryTargetUser")
  openedEscalations    Escalation[]       @relation("EscalationOpener")
  escalationEvents     EscalationEvent[]  @relation("EscalationEventActor")
  memberships          Membership[]       @relation("MembershipProfile")
  invitedMemberships   Membership[]       @relation("MembershipInviter")

  @@index([isActive, role])
}

// ─────────────────────────────────────────────────────────────────
// DEVICE REGISTRY (SY-email)
// SMS-OTP is gone (SY0). Enrollment-code path is gone (SY-email).
// A user signs in via Supabase email OTP; the mobile app then
// registers this device via register_device() so admins can see +
// revoke it from /admin/devices. One active device per user.
// ─────────────────────────────────────────────────────────────────

model Device {
  id          String    @id
  profileId   String    @db.Uuid
  label       String
  platform    String
  osVersion   String?
  appVersion  String?
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz
  enrolledAt  DateTime  @default(now()) @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  revokedById String?   @db.Uuid

  profile   Profile  @relation("DeviceOwner", fields: [profileId], references: [id], onDelete: Cascade)
  revokedBy Profile? @relation("DeviceRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([profileId, revokedAt])
}

enum UserAuditAction {
  CREATED
  ACTIVATED
  DEACTIVATED
  ROLE_CHANGED
  PHONE_CHANGED
  EMAIL_CHANGED
  ENROLLMENT_CODE_ISSUED
  DEVICE_ENROLLED
  DEVICE_REVOKED
  INVITED
  INVITE_RESENT
}

model UserAuditLog {
  id              String          @id @default(cuid())
  actorId         String?         @db.Uuid
  targetProfileId String          @db.Uuid
  action          UserAuditAction
  detail          String?
  createdAt       DateTime        @default(now()) @db.Timestamptz

  // SY21 — organizationId of the acted-on user (via their membership).
  // Same user can be in >1 org; the action determines which one the
  // audit belongs to.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  actor  Profile? @relation("UserAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target Profile  @relation("UserAuditTarget", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@index([targetProfileId, createdAt])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// BUSINESS SETTINGS  (single row per deployment)
// ─────────────────────────────────────────────────────────────────

// SY21 — 1:1 with Organization (was 1:1 with Profile). The
// backfill migration keeps the owner's row and rewrites profileId to
// the org id; the profileId column is dropped in the same
// migration. Per-org proforma/credit-note counters moved out to
// OrgNumberSequence.
model BusinessSettings {
  id             String @id @default(cuid())
  organizationId String @unique @db.Uuid

  // Onboarding
  accountingTool AccountingTool @default(EXCEL)
  onboardingDone Boolean        @default(false)

  // Company details
  companyGstNumber String?
  companyAddress   String?
  companyState     String?
  companyCityPin   String?

  // AR defaults
  defaultCreditDays Int?

  // Outreach guardrails (enforced by the deterministic sending gate)
  timezone             String  @default("Asia/Kolkata") // IANA tz for quiet hours
  quietHoursStart      Int     @default(8) // local hour — no sends before this
  quietHoursEnd        Int     @default(19) // local hour — no sends at/after this
  maxMessagesPerDay    Int     @default(1) // per party, per calendar day
  maxMessagesPerWeek   Int     @default(3) // per party, rolling 7 days
  autoRemindersEnabled Boolean @default(false) // cron-driven reminder pass

  // Organisation-level Tally-integration toggle. See lib/settings.ts.
  // When false: hide every Tally UI surface, skip Tally-only cron
  // passes, and switch honest empty states in for "Last synced" banners.
  tallyEnabled Boolean @default(false)

  // Minimum mobile app version this deployment accepts. NULL = no
  // floor. When the device's Constants.expoConfig.version is lower,
  // the mobile app blocks the shell and shows an "update required"
  // screen. Reserved for security releases; routine version bumps
  // ride the OTA "update available" banner.
  mobileMinAppVersion String?

  // P1 — order approval workflow. See migration
  // 20260821200000_order_approval_workflow for the mode semantics.
  // Default flipped to ALL by 20260826120000_require_admin_approval_all_orders:
  // every STAFF order must be approved by an admin before the factory
  // can see it.
  orderApprovalMode OrderApprovalMode @default(ALL)

  // Audit item 10 (2026-09-28). Human-readable toggle that mirrors
  // orderApprovalMode=ALL. Kept as a plain boolean so /settings can
  // show a single switch instead of the three-state enum; the enum
  // stays for reporting. Defaults true on all existing rows via the
  // 20260929010000_require_approval_toggle migration.
  requireApprovalForAllOrders Boolean @default(true)

  // SY23 — TOTP for management is optional per org. Default false
  // (a new distributor onboarding shouldn't be blocked by a QR-code
  // wall). requireAdmin() reads this flag to decide whether an aal1
  // session bounces to /login/challenge; when false, the caller
  // still gets a dismissible "Protect your account" nudge in the
  // dashboard. The 20260929050000_saas_onboarding migration flips
  // Synergy's row to true so nothing changes for the pilot tenant.
  requireManagement2fa Boolean @default(false)

  // SY23 — onboarding wizard progress. Nullable strings so a partial
  // step can be resumed. Cleared when onboardingDone flips true.
  onboardingStep String?

  // SY23 — one-time sample data flag. Trip-wire for the demo dataset
  // seeded by /onboarding step (c) → "Try with sample data". A
  // separate row-scan job or the admin can toggle it off and the
  // sample rows purge together (deletion path lives in
  // lib/onboarding/sample.ts).
  sampleDataSeeded Boolean @default(false)

  // SY24 — per-organization catalogue pick-lists. The mobile order
  // wizard renders these on the brand and packing chips; when null
  // the app falls back to a starter list so a brand-new tenant
  // isn't blocked from placing an order. Managed from
  // /admin/products on the web. JSONB arrays of strings.
  brandList   Json?
  packingList Json?

  // SY24 — factory role can see money figures (rates, order value)
  // when true. Default false so a new distributor's shop-floor
  // users only see qty/customer/due-date. Synergy uses an
  // accountant with the FACTORY role for invoicing, so their row
  // is flipped true by the migration.
  factoryCanSeeRates Boolean @default(false)

  // Proforma / credit note sequences moved to OrgNumberSequence
  // (SY21). See migration 20260929030000_multi_tenant_orgs for the
  // backfill; existing counters are copied into the new table before
  // the columns are dropped.

  // Company branding & bank details (rendered on proforma/invoice PDFs)
  // companyLogoPath is an object path in the private Supabase Storage
  // bucket (lib/storage.ts) — read via short-lived signed URLs only.
  // bankAccountNumber is AES-256-GCM encrypted at rest (lib/crypto.ts);
  // decrypt server-side only, never select into a client payload.
  companyLogoPath         String?
  bankAccountName         String?
  bankAccountNumber       String?
  bankIfscCode            String?
  bankName                String?
  bankBranch              String?
  invoicePrefix           String? // e.g. "INV" — used when converting proformas
  authorizedSignatoryName String?

  // Tally sync config
  tallyHost        String?
  tallyPort        Int? // default 9000
  tallyCompanyName String?

  // WhatsApp Business API config
  // whatsappApiToken is AES-256-GCM encrypted at rest (lib/crypto.ts).
  // Decrypt server-side only; never select it into a client payload.
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?
  whatsappApiToken          String?
  // Pre-approved UTILITY-category template used for reminders.
  // Marketing-category templates must never be used for payment follow-ups.
  whatsappTemplateName      String?

  // SY21 — per-tenant secrets that used to live in Vercel env vars.
  // All AES-256-GCM encrypted at rest (lib/crypto.ts) except IDs.
  // lib/settings/secrets.ts reads these first and falls back to the
  // matching env var for the Synergy migration window.
  razorpayKeyId          String?
  razorpayKeySecret      String?
  razorpayWebhookSecret  String?
  // Tally sync agent auth — SHA-256 of the shared secret (SY27).
  // Compared with timingSafeEqual against the incoming bearer token.
  tallySyncTokenHash     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────
// PARTY  (customer / buyer)
// ─────────────────────────────────────────────────────────────────

model Party {
  id            String  @id @default(cuid())
  name          String
  code          String? // internal code / Tally alias
  gstNumber     String?
  phone         String?
  email         String?
  contactPerson String? // primary contact for payment follow-up
  address       String?
  city          String?
  state         String?

  creditLimit Decimal? @db.Decimal(12, 2)
  creditDays  Int? // agreed payment terms in days

  // Cached AR balance — update via app whenever invoices or payments change
  totalOutstanding Decimal   @default(0) @db.Decimal(12, 2)
  // Snapshot from the last Tally ledger sync — the reconciliation
  // report compares this against totalOutstanding to catch sync bugs.
  tallyOutstanding Decimal?  @db.Decimal(14, 2)
  tallyBalanceAsOf DateTime? @db.Timestamptz

  // Tally Cost Centre / Sales Executive name — used for auto-assignment
  // to the Profile whose costCentreName matches this value
  costCentre String?

  priority  PartyPriority @default(MEDIUM)
  riskLevel RiskLevel     @default(LOW)
  isActive  Boolean       @default(true)

  assignedToId String?  @db.Uuid
  assignedTo   Profile? @relation("PartyAssignee", fields: [assignedToId], references: [id])

  // SY21 — populated by the multi_tenant_orgs backfill, then set
  // NOT NULL at the DB. Type stays nullable in Prisma until the
  // create-site sweep lands so existing db.party.create calls still
  // typecheck; the DB CHECK stops nulls at the boundary.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Deduplication key for Tally sync; null for manually-added parties.
  // Per-org unique (SY21) — was global @unique before.
  tallyRef String?

  // ── Outreach compliance ────────────────────────────────────────
  // No automated message may be sent unless consentStatus is OPTED_IN.
  consentStatus    ConsentStatus @default(UNKNOWN)
  consentUpdatedAt DateTime?

  // Set when a DISPUTED outcome is recorded (or manually). Blocks ALL
  // outbound messages until a human clears it.
  outreachPaused       Boolean   @default(false)
  outreachPausedReason String?
  outreachPausedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  payments     Payment[]
  actions      Action[]
  proformas    ProformaInvoice[]
  messages     Message[]
  paymentLinks PaymentLink[]
  creditNotes  CreditNote[]
  salesOrders  SalesOrder[]

  escalations    Escalation[]
  recommendation Recommendation?

  @@unique([organizationId, tallyRef])
  @@index([assignedToId])
  @@index([isActive, priority])
  @@index([totalOutstanding])
  @@index([riskLevel])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  partyId        String
  invoiceDate    DateTime
  dueDate        DateTime
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  // Cached Σ(amount) over non-cancelled credit notes on this invoice.
  // Maintained inside the credit-note issue/cancel transactions.
  creditedAmount Decimal       @default(0) @db.Decimal(12, 2)
  // pendingAmount = totalAmount - paidAmount - creditedAmount → computed in app
  status         InvoiceStatus @default(UNPAID)
  source         InvoiceSource @default(MANUAL)
  tallyRef       String? // Tally voucher ref for sync dedup
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SY21 — organizationId (populated by backfill, DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  party        Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  payments     Payment[]
  messages     Message[]
  paymentLinks PaymentLink[]
  creditNotes  CreditNote[]

  // Invoice numbers are unique per organization (SY21). Also kept
  // per-party so a single ledger stays consistent for readers.
  @@unique([organizationId, invoiceNumber])
  @@unique([partyId, invoiceNumber])
  @@index([partyId])
  @@index([dueDate])
  @@index([status])
  @@index([partyId, status])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  partyId     String
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime
  method      PaymentMethod @default(NEFT)
  reference   String? // cheque number, UTR, UPI transaction ID
  notes       String?

  // Optional single-invoice link for v1.
  // Upgrade path: add a PaymentAllocation join table for split payments.
  invoiceId String?

  recordedById String        @db.Uuid
  source       PaymentSource @default(MANUAL)
  // Format: 'receipt:<voucher-guid>:<invoice-number>' for allocated rows,
  // 'receipt:<voucher-guid>:onaccount' for the residual. Per-org
  // unique (SY21). Partial-unique in the DB so re-runs of the Tally
  // sync upsert instead of duplicating.
  tallyRef     String?

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party      Party             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice    Invoice?          @relation(fields: [invoiceId], references: [id])
  recordedBy Profile           @relation("PaymentRecorder", fields: [recordedById], references: [id])
  documents  PaymentDocument[]

  @@unique([organizationId, tallyRef])
  @@index([partyId])
  @@index([paymentDate])
  @@index([partyId, paymentDate])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// PAYMENT DOCUMENT (bank screenshot, cheque photo, UPI screenshot,
// signed receipt — anything a salesperson / accountant photographs
// alongside a payment for later bank reconciliation)
// ─────────────────────────────────────────────────────────────────

model PaymentDocument {
  id           String              @id @default(cuid())
  paymentId    String
  type         PaymentDocumentType
  storagePath  String // Supabase Storage object path, private bucket
  fileName     String? // original client filename for display
  uploadedById String              @db.Uuid
  notes        String?
  createdAt    DateTime            @default(now())

  // SY21 — organizationId, denormalized from Payment (populated by
  // backfill, DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedBy Profile @relation("PaymentDocumentUploader", fields: [uploadedById], references: [id])

  @@index([paymentId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// ACTION / FOLLOW-UP LOG
// ─────────────────────────────────────────────────────────────────

model Action {
  id              String         @id @default(cuid())
  partyId         String
  performedById   String         @db.Uuid
  type            ActionType
  outcome         ActionOutcome?
  notes           String?
  contactedPerson String? // who was spoken to at the party side

  // Promise-to-pay tracking
  promiseDate   DateTime?
  promiseAmount Decimal?  @db.Decimal(12, 2)

  // Next follow-up scheduling
  nextFollowUpDate DateTime?

  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  party       Party   @relation(fields: [partyId], references: [id], onDelete: Restrict)
  performedBy Profile @relation("ActionPerformer", fields: [performedById], references: [id])

  @@index([partyId])
  @@index([performedById])
  @@index([nextFollowUpDate])
  @@index([partyId, performedAt])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// PROFORMA INVOICE
// ─────────────────────────────────────────────────────────────────

model ProformaInvoice {
  id             String         @id @default(cuid())
  // SY21 — per-org unique now; the global @unique came off.
  proformaNumber String         // format: PF-{YYYY}-{NNNN}, generated by app
  partyId        String
  createdById    String         @db.Uuid
  issueDate      DateTime       @default(now())
  validUntil     DateTime?
  status         ProformaStatus @default(DRAFT)

  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  notes           String?
  termsConditions String?

  // Populated when status transitions to CONVERTED
  convertedToInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  party     Party              @relation(fields: [partyId], references: [id], onDelete: Restrict)
  createdBy Profile            @relation("ProformaCreator", fields: [createdById], references: [id])
  lineItems ProformaLineItem[]

  @@unique([organizationId, proformaNumber])
  @@index([partyId])
  @@index([status])
  @@index([organizationId])
}

model ProformaLineItem {
  id          String  @id @default(cuid())
  proformaId  String
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unit        String? // "kg", "box", "pcs", "mtr", etc.
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2) // 18.00 = 18% GST
  taxAmount   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2) // (qty × unitPrice) + taxAmount
  sortOrder   Int     @default(0)

  // SY21 — organizationId denormalized from parent (backfill fills it).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  proforma ProformaInvoice @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// CREDIT NOTE  (returns / discounts / adjustments against an invoice;
// reduces the invoice's pending balance without touching payment rows)
// ─────────────────────────────────────────────────────────────────

model CreditNote {
  id               String           @id @default(cuid())
  // SY21 — per-org unique now; the global @unique came off.
  creditNoteNumber String           // format: CN-{YYYY}-{NNNN}, generated by app
  invoiceId        String
  partyId          String
  amount           Decimal          @db.Decimal(12, 2)
  reason           String
  status           CreditNoteStatus @default(ISSUED)

  issuedById String   @db.Uuid
  issuedAt   DateTime @default(now())

  // Cancellation audit trail (admin-only action)
  cancelledById    String?   @db.Uuid
  cancelledAt      DateTime?
