  // matches the tenancy boundary.
  providerLinkId String
  shortUrl       String
  amount         Decimal @db.Decimal(12, 2)
  status         String  @default("created") // Razorpay: created/partially_paid/paid/cancelled/expired

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party   Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([organizationId, providerLinkId])
  @@index([partyId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// ACCOUNTING CONNECTION  (cloud accounting OAuth — Zoho Books,
// QuickBooks, Xero. One connection per provider: single-tenant deploy.)
// ─────────────────────────────────────────────────────────────────

model AccountingConnection {
  id       String             @id @default(cuid())
  // SY21 — per-org unique now (was global @unique).
  provider AccountingProvider

  // OAuth tokens, AES-256-GCM encrypted at rest (lib/crypto.ts).
  // Decrypt server-side only; never select into a client payload.
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?

  // Provider tenant: QuickBooks realmId, Xero tenantId, Zoho organization_id
  externalOrgId String?

  connectedAt DateTime  @default(now())
  lastSyncAt  DateTime?
  updatedAt   DateTime  @updatedAt

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// PRODUCT  (factory catalogue — Polygum / Ombond / Omcol / etc.)
// ─────────────────────────────────────────────────────────────────

model Product {
  id        String   @id @default(cuid())
  name      String
  brand     String
  // Factory-side grade code (PA-60s for Polygum Special Purpose,
  // WR-48 for Polygum D3+, PSA 55 for the industrial grade, etc.).
  // Salespeople search by either the marketing name OR this code;
  // factory sees the code on order cards. Nullable — commodity
  // products (Cyanoacrylate, Heatproof) don't have a grade code.
  code      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  // Optional per-product floor price. Orders below this flip
  // SalesOrder.needsRateApproval and stay hidden from the factory
  // until an admin approves. See lib/orders/create.ts + F6 flow.
  floorRate Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  // Product catalogue becomes per-org — Synergy's Polygum ≠ another
  // distributor's Polygum. (name, brand) unique per org.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  salesOrders     SalesOrder[]
  salesOrderItems SalesOrderItem[]

  @@unique([organizationId, name, brand])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// SALES ORDER  (salesperson → factory order pipeline)
// ─────────────────────────────────────────────────────────────────

model SalesOrder {
  id          String @id @default(cuid())
  // SY21 — per-org unique now (was global @unique).
  orderNumber String // format: SB/YY-YY/NNNN, generated same pattern as proformaNumber

  // Exactly one of these two must be set — enforce in application logic, not just here:
  partyId         String? // existing customer, chosen from the salesperson's own ledger dropdown
  newCustomerName String? // free text, only used when the customer isn't in Tally yet

  salespersonId          String              @db.Uuid
  // ─────────────────────────────────────────────────────────────────
  // DEPRECATED single-SKU scalars. Kept for backwards compatibility
  // with the Tally connector, the current mobile build, and every web
  // page still reading `order.product.name` / `order.quantity`. Line
  // data now lives in SalesOrderItem; a trigger keeps these mirrored
  // to line 1 (with `orderValue` = SUM of all lineValue). Do NOT drop
  // in this migration — see docs/MULTI-SKU-MIGRATION.md for the
  // reader migration checklist.
  // ─────────────────────────────────────────────────────────────────
  productId              String // deprecated: mirrors items[0].productId
  brand                  String // deprecated: mirrors items[0].brand
  quantity               Decimal             @db.Decimal(10, 3) // deprecated: mirrors items[0].quantity
  quantityUnit           String // deprecated: mirrors items[0].quantityUnit
  packingType            String? // deprecated: mirrors items[0].packingType
  sizeKg                 String? // deprecated: mirrors items[0].sizeKg
  productRate            String // deprecated: mirrors items[0].productRate
  orderValue             Decimal             @db.Decimal(12, 2) // subtotal — SUM(items.lineValue), pre-discount, pre-GST
  // Pricing tier on top of orderValue (subtotal). Applied in order:
  //   discountAmount = round(orderValue × discountPct / 100, 2)
  //   taxableAmount  = orderValue − discountAmount
  //   gstAmount      = round(taxableAmount × gstPct / 100, 2)
  //   grandTotal     = taxableAmount + gstAmount
  // Persisted so invoices, Tally exports, and any downstream reader
  // don't have to re-derive from the display layer.
  discountPct            Decimal             @default(0) @db.Decimal(5, 2)
  discountAmount         Decimal             @default(0) @db.Decimal(12, 2)
  taxableAmount          Decimal             @default(0) @db.Decimal(12, 2)
  gstPct                 Decimal             @default(18) @db.Decimal(5, 2)
  gstAmount              Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal             Decimal             @default(0) @db.Decimal(12, 2)
  paymentTerm            String?
  transportType          String?
  expectedDeliveryDate   DateTime?
  // Free text — the address the goods should be dispatched to (may differ
  // from the ledger address, e.g. sub-dealer godown).
  dispatchLocation       String?
  // "With Synergy Barcode Token" | "With Customer Token" | "Without Token" |
  // "Gift inside" | free text via "Other".
  tokenType              String?
  // Filled by factory after order is placed.
  expectedProductionDate DateTime?
  notes                  String?
  currentStatus          OrderStatus         @default(ORDER_PLACED)
  // Stamped when a salesperson (or the customer via a signed link)
  // confirms receipt. Lets us compute order-to-delivery time without
  // scanning the event log.
  deliveredAt            DateTime?           @db.Timestamptz
  // Set by putOrderOnHold; releaseOrderHold restores currentStatus to this.
  statusBeforeHold       OrderStatus?
  holdReasonCategory     HoldReasonCategory?
  holdReason             String?
  linkedInvoiceId        String?

  // Credit-limit check outcome at time of placement — kept for audit even if the
  // customer's limit changes later
  creditCheckPassed  Boolean @default(true)
  creditOverrideById String? @db.Uuid // set when a director overrides a blocked order
  creditOverrideNote String?

  // DEPRECATED (2026-08-26, require_admin_approval_all_orders):
  // floor-rate gate removed. Columns kept for reader compatibility;
  // create_sales_order_v2 no longer writes them.
  needsRateApproval Boolean   @default(false)
  rateApprovedById  String?   @db.Uuid
  rateApprovedAt    DateTime? @db.Timestamptz
  rateApprovalNote  String?

  // Audit item 10 — stamp for the "waiting > 30 min" admin push
  // (cron: /api/cron/notify-pending-approval). Null → never notified.
  adminPendingNotifiedAt DateTime? @db.Timestamptz

  // P1 — general order-approval workflow. Filled by
  // approveOrderAction / rejectOrderAction; rejectionReason is
  // required by the action, so REJECTED rows always have context.
  approvedById    String?   @db.Uuid
  approvedAt      DateTime? @db.Timestamptz
  rejectedById    String?   @db.Uuid
  rejectedAt      DateTime? @db.Timestamptz
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  party        Party?             @relation(fields: [partyId], references: [id])
  salesperson  Profile            @relation("OrderSalesperson", fields: [salespersonId], references: [id])
  product      Product            @relation(fields: [productId], references: [id])
  items        SalesOrderItem[]
  statusEvents OrderStatusEvent[]
  documents    OrderDocument[]
  dispatchLots DispatchLot[]
  comments     OrderComment[]

  @@unique([organizationId, orderNumber])
  @@index([salespersonId, createdAt])
  @@index([partyId])
  @@index([currentStatus])
  @@index([expectedDeliveryDate])
  @@index([organizationId])
}

// One SKU on a multi-line sales order. Rate approval and floor-rate
// checks are per-line; the header's needsRateApproval is derived by
// trigger as OR-of-lines so RLS policies that read
// SalesOrder."needsRateApproval" keep working unchanged.
model SalesOrderItem {
  id           String  @id @default(cuid())
  salesOrderId String
  productId    String
  brand        String
  quantity     Decimal @db.Decimal(10, 3)
  quantityUnit String
  packingType  String?
  sizeKg       String?
  productRate  String
  lineValue    Decimal @db.Decimal(12, 2)
  lineNumber   Int

  // DEPRECATED (2026-08-26, require_admin_approval_all_orders):
  // per-line floor-rate gate removed. Columns kept for reader
  // compatibility; create_sales_order_v2 no longer writes them.
  needsRateApproval Boolean   @default(false)
  rateApprovedById  String?   @db.Uuid
  rateApprovedAt    DateTime? @db.Timestamptz
  rateApprovalNote  String?

  // Per-line production tracking. A 4-SKU order is rarely produced
  // simultaneously — the factory ticks lines READY one at a time and
  // SalesOrder.currentStatus is recomputed from the aggregate by
  // trigger `_recompute_order_status_from_lines`.
  productionStatus LineProductionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SY21 — organizationId denormalized from parent SalesOrder.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])
  rateApprover Profile?   @relation("SalesOrderItemRateApprover", fields: [rateApprovedById], references: [id])

  @@unique([salesOrderId, lineNumber])
  @@index([salesOrderId])
  @@index([organizationId])
}

model OrderStatusEvent {
  id           String      @id @default(cuid())
  salesOrderId String
  status       OrderStatus
  notes        String?
  updatedById  String      @db.Uuid
  createdAt    DateTime    @default(now())

  // SY21 — organizationId denormalized from parent (backfill fills it).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  updatedBy  Profile    @relation("OrderStatusUpdater", fields: [updatedById], references: [id])

  @@index([salesOrderId, createdAt])
  @@index([organizationId])
}

model DispatchLot {
  id           String   @id @default(cuid())
  salesOrderId String
  // Same unit as SalesOrder.quantity. Trigger _on_dispatch_lot_change
  // recomputes SalesOrder.currentStatus (PARTIALLY_DISPATCHED /
  // DISPATCHED) based on sum(quantity) vs SalesOrder.quantity.
  quantity     Decimal  @db.Decimal(14, 3)
  lrNumber     String?
  dispatchedAt DateTime @default(now()) @db.Timestamptz
  notes        String?
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  // SY21 — organizationId denormalized from parent (backfill fills it).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  createdBy  Profile    @relation("DispatchLotCreator", fields: [createdById], references: [id])

  @@index([salesOrderId])
  @@index([organizationId])
}

model OrderComment {
  id           String   @id @default(cuid())
  salesOrderId String
  authorId     String   @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @db.Timestamptz

  // SY21 — organizationId denormalized from parent (backfill fills it).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  author     Profile    @relation("OrderCommentAuthor", fields: [authorId], references: [id])

  @@index([salesOrderId, createdAt])
  @@index([authorId])
  @@index([organizationId])
}

model OrderDocument {
  id           String       @id @default(cuid())
  salesOrderId String
  type         DocumentType
  storagePath  String // Supabase Storage object path, private bucket
  uploadedById String       @db.Uuid
  createdAt    DateTime     @default(now())

  // Multi-page support. Rows with the same (salesOrderId, pageGroupId)
  // form ONE logical document (e.g. a 3-page LR). pageIndex is 1-based.
  // Nullable for legacy rows; the client sets both for new uploads.
  pageGroupId String?
  pageIndex   Int?

  // SY21 — organizationId denormalized from parent (backfill fills it).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  uploadedBy Profile    @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([salesOrderId])
  @@index([pageGroupId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// STOCK ITEM  (Tally stock snapshot for factory availability)
// ─────────────────────────────────────────────────────────────────

model StockItem {
  id           String    @id @default(cuid())
  // SY21 — per-org unique now (were global @unique before).
  name         String
  category     String?
  unit         String?
  closingQty   Decimal   @db.Decimal(12, 3)
  tallyRef     String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // SY21 — organizationId, populated by backfill (DB NOT NULL after).
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@unique([organizationId, tallyRef])
  @@index([name])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────
// AUTH SECURITY  (defense-in-depth on top of Supabase rate-limiting)
// ─────────────────────────────────────────────────────────────────

model PushToken {
  id         String   @id @default(cuid())
  profileId  String   @db.Uuid
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @db.Timestamptz
  lastSeenAt DateTime @default(now()) @db.Timestamptz

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// SY21 — now per-org. Pre-SY21 rows had id='global'; the migration
// renames it and links to Synergy. New rows key on organizationId.
model NotificationConfig {
  id                 String   @id
  edgeFunctionUrl    String?
  edgeFunctionSecret String?
  staleOrderHours    Int      @default(24)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz

  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model StaleOrderNotice {
  salesOrderId String   @id
  notifiedAt   DateTime @default(now()) @db.Timestamptz

  // SY21 — organizationId denormalized from SalesOrder.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  // Exactly one of email / phone is set. Web login uses email; mobile
  // phone OTP flow uses phone. CHECK constraint in the migration
  // enforces at-least-one at the DB level.
  email      String?
  phone      String?
  // Which factor this attempt was for. PASSWORD covers the classic
  // email+password grant; TOTP covers the second-factor challenge;
  // RECOVERY covers a backup-code redemption. Rate limits filter by
  // factor so a bad password can't burn your MFA-code budget.
  factor     LoginAttemptFactor @default(PASSWORD)
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([phone, createdAt])
  @@index([email, factor, createdAt])
}

enum LoginAttemptFactor {
  PASSWORD
  TOTP
  RECOVERY
  EMAIL_OTP
}

// SY23 — signup abuse control. One row per POST /api/signup, no
// authenticated identity yet. Consumed by /api/signup itself.
model SignupAttempt {
  id          String   @id @default(cuid())
  emailDomain String
  ip          String
  successful  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([ip, createdAt])
  @@index([emailDomain, createdAt])
}

// SY27 — Tally per-org pairing.
//
// TallyPairingCode: short-lived one-time code an ADMIN generates in
// Settings → Tally. Only its SHA-256 hash is stored so the plaintext
// never sits at rest. Expires 15 min after generation; consumed row
// keeps the audit trail without letting the code be reused.
//
// TallyConnector: the paired Windows PC. Only the SHA-256 hash of the
// long-lived token is stored — the plaintext is shown once during
// pairing and never again. Revoking flips revokedAt; every subsequent
// /api/sync/tally call for this token returns 401.
model TallyPairingCode {
  id             String    @id @default(cuid())
  organizationId String    @db.Uuid
  codeHash       String    @unique
  createdById    String    @db.Uuid
  expiresAt      DateTime  @db.Timestamptz
  consumedAt     DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
}

model TallyConnector {
  id              String    @id @default(cuid())
  organizationId  String    @db.Uuid
  name            String
  tokenHash       String    @unique
  lastSeenAt      DateTime? @db.Timestamptz
  lastSyncAt      DateTime? @db.Timestamptz
  lastError       String?
  rowsSyncedTotal Int       @default(0)
  revokedAt       DateTime? @db.Timestamptz
  revokedById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
}

// One-time backup codes shown once at TOTP enrolment. Codes generated
// server-side, plaintext returned exactly once (via the enrol RPC
// wrapper). Only the SHA-256 hash lives in the DB.
model RecoveryCode {
  id        String    @id
  profileId String    @db.Uuid
  codeHash  String
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  profile Profile @relation("RecoveryCodeOwner", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, usedAt])
}

// ─────────────────────────────────────────────────────────────────
// RECOVERY  (targets, escalation ladder, AI recommendations)
// See docs/superpowers/specs/2026-07-21-recovery-backend-design.md
// ─────────────────────────────────────────────────────────────────

model RecoveryTarget {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  month        DateTime // canonical label: Date.UTC(y, m, 1) for the IST month
  targetAmount Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // SY21 — organizationId; a user can have targets in more than one org.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  user Profile @relation("RecoveryTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, month])
  @@index([userId, month])
  @@index([organizationId])
}

model Escalation {
  id         String           @id @default(cuid())
  partyId    String
  stage      EscalationStage  @default(FLAGGED)
  status     EscalationStatus @default(OPEN)
  reason     String
  openedById String?          @db.Uuid // null = auto-flagged by cron
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // SY21 — organizationId denormalized from Party.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  party    Party             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  openedBy Profile?          @relation("EscalationOpener", fields: [openedById], references: [id])
  events   EscalationEvent[]

  @@index([status, stage])
  @@index([partyId])
  @@index([organizationId])
}

model EscalationEvent {
  id           String           @id @default(cuid())
  escalationId String
  fromStage    EscalationStage?
  toStage      EscalationStage
  note         String
  byId         String?          @db.Uuid // null = system (cron)
  createdAt    DateTime         @default(now())

  // SY21 — organizationId denormalized from Escalation.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  escalation Escalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  by         Profile?   @relation("EscalationEventActor", fields: [byId], references: [id])

  @@index([escalationId, createdAt])
  @@index([organizationId])
}

model Recommendation {
  id          String   @id @default(cuid())
  partyId     String   @unique
  content     Json // { nextAction, urgency, talkingPoints, draftMessage }
  model       String // "claude-haiku-4-5" | "rules-fallback"
  generatedAt DateTime @default(now())

  // SY21 — organizationId denormalized from Party.
  organizationId String?      @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
