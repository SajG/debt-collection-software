# ---------------------------------------------------------------
# Supabase project credentials
# Find these in: Supabase dashboard → Project Settings → API
# ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key — server-only, never expose to client
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------
# Prisma / Postgres
# Use the pooled URL (pgBouncer port 6543) for runtime queries.
# Use the direct URL (port 5432) for migrations only.
# Both found in: Supabase dashboard → Project Settings → Database
# ---------------------------------------------------------------

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------
# Secrets at rest
# Encrypts stored provider credentials (e.g. WhatsApp API token).
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------

APP_ENCRYPTION_KEY=""

# ---------------------------------------------------------------
# Scheduled reminders
# Shared secret the cron caller must send as `Authorization: Bearer ...`
# to /api/cron/reminders. Generate: openssl rand -hex 32
# ---------------------------------------------------------------

CRON_SECRET=""

# ---------------------------------------------------------------
# Messaging channels (all optional — an unconfigured channel fails
# closed and logs a FAILED message; it never sends).
# WhatsApp Cloud API credentials live in Settings (encrypted in DB),
# except the webhook verify token which is deployment config:
# ---------------------------------------------------------------

WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# SMS via MSG91 (https://msg91.com)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""

# Email via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="reminders@yourdomain.example"

# ---------------------------------------------------------------
# Payment links — Razorpay (UPI + partial payments)
# ---------------------------------------------------------------

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
