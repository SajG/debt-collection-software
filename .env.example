# ---------------------------------------------------------------
# Supabase project credentials
# Find these in: Supabase dashboard → Project Settings → API
# ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key — server-only, never expose to client
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------
# Prisma / Postgres
# Use the pooled URL (pgBouncer port 6543) for runtime queries.
# Use the direct URL (port 5432) for migrations only.
# Both found in: Supabase dashboard → Project Settings → Database
# ---------------------------------------------------------------

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------
# Secrets at rest
# Encrypts stored provider credentials (e.g. WhatsApp API token).
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------

APP_ENCRYPTION_KEY=""

# ---------------------------------------------------------------
# Scheduled reminders
# Shared secret the cron caller must send as `Authorization: Bearer ...`
# to /api/cron/reminders. Generate: openssl rand -hex 32
# ---------------------------------------------------------------

CRON_SECRET=""

# ---------------------------------------------------------------
# Messaging channels (all optional — an unconfigured channel fails
# closed and logs a FAILED message; it never sends).
# WhatsApp Cloud API credentials live in Settings (encrypted in DB),
# except the webhook verify token which is deployment config:
# ---------------------------------------------------------------

WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# SMS via MSG91 (https://msg91.com)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""

# Email via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="login@getsyncit.app"

# ---------------------------------------------------------------
# Payment links — Razorpay (UPI + partial payments)
# ---------------------------------------------------------------

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---------------------------------------------------------------
# Live accounting sync (all optional)
# Tally: shared secret the LAN sync agent (tools/tally-sync-agent.mjs)
# sends as `Authorization: Bearer ...` to /api/sync/tally.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------

TALLY_SYNC_SECRET=""

# Cloud accounting OAuth apps (redirect URI:
# {APP_URL}/api/integrations/{zoho-books|quickbooks|xero}/callback)
APP_URL="https://getsyncit.app"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
# Zoho region bases; defaults target India (.in)
# ZOHO_ACCOUNTS_BASE="https://accounts.zoho.in"
# ZOHO_API_BASE="https://www.zohoapis.in"
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_API_BASE="https://sandbox-quickbooks.api.intuit.com" # for sandbox
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# Razorpay webhook signing secret (dashboard → Webhooks). Updates payment
# link status only; payments are still recorded by a human.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------
# Syncit subscription billing (SY28) — Syncit's OWN Razorpay account.
# NOT the keys above: RAZORPAY_KEY_* collect money for a distributor
# from its customers; RAZORPAY_PLATFORM_* charge distributors for Syncit.
# Use rzp_test_* keys until go-live.
# ---------------------------------------------------------------

RAZORPAY_PLATFORM_KEY_ID=""
RAZORPAY_PLATFORM_KEY_SECRET=""
# Platform account → Webhooks → {APP_URL}/api/webhooks/razorpay-billing,
# events: subscription.* and payment.failed. Paste the secret you set there.
RAZORPAY_PLATFORM_WEBHOOK_SECRET=""
# Plan ids — run `npm run billing:create-plans` once per Razorpay
# account (test and live) and paste what it prints.
RAZORPAY_PLATFORM_PLAN_STARTER_MONTHLY=""
RAZORPAY_PLATFORM_PLAN_STARTER_ANNUAL=""
RAZORPAY_PLATFORM_PLAN_GROWTH_MONTHLY=""
RAZORPAY_PLATFORM_PLAN_GROWTH_ANNUAL=""

# Seller block on Syncit's GST tax invoices.
BILLING_LEGAL_NAME=""
BILLING_GSTIN=""
BILLING_ADDRESS=""
BILLING_CITY_PIN=""
# Full state name, compared to the buyer's state for CGST+SGST vs IGST.
BILLING_STATE="Maharashtra"
BILLING_SIGNATORY_NAME=""
# Invoice number prefix → SYN/2026-27/0001
BILLING_INVOICE_PREFIX="SYN"

# Error monitoring (optional). When set, send-pipeline and cron failures are
# reported to Sentry; without it they only reach the server log.
SENTRY_DSN=""

# ---------------------------------------------------------------
# F4 — customer-facing order-status link (lib/status-link.ts)
# HMAC-SHA256 signing secret for /status/[token]. Rotate on suspected
# leak — every outstanding link becomes invalid on rotation.
# ---------------------------------------------------------------
STATUS_LINK_SECRET=""

# Public base URL used to build absolute status links so a link
# opened from a WhatsApp message on the customer's phone works.
NEXT_PUBLIC_APP_URL="https://getsyncit.app"

# ---------------------------------------------------------------
# F7 — WhatsApp dispatch confirmation (lib/messaging/dispatch-confirmation.ts)
# Meta Cloud API. Optional — leaving these unset skips the send
# cleanly (the status advance still happens).
# ---------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_DISPATCH_TEMPLATE_NAME=""
WHATSAPP_DISPATCH_TEMPLATE_LANG="en"

# ---------------------------------------------------------------
# Recovery module — Anthropic API for per-party AI collection
# recommendations. Optional; when unset the app falls back to
# deterministic rules-based advice (spec §3).
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------
# SY31 — self-serve signup. "true" shows the /signup form and the
# Google button on /login + /signup. Anything else (default) shows
# "We're onboarding companies one by one — message us on WhatsApp".
# ---------------------------------------------------------------
SIGNUP_ENABLED="false"
